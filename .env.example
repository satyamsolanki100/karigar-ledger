# Postgres (docker compose uses port 5433 so it does not clash with a local install)
DATABASE_URL="postgresql://karigar:karigar@localhost:5433/karigar_ledger?schema=public"

# Auth.js session signing secret: `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Scale photo reading. Leave ANTHROPIC_API_KEY empty to use the local mock reader.
ANTHROPIC_API_KEY=""
SCALE_READER="mock"
